[Unit]
Description=NVT native guest outbound session
After=network-online.target nvt-guest-identity.service nvt-agent-guest.service
Wants=network-online.target
Requires=nvt-guest-identity.service nvt-agent-guest.service

[Service]
Type=simple
User=root
Group=nvt-agent
UMask=0027
RuntimeDirectory=nvt-agent-session
RuntimeDirectoryMode=0750
ExecStart=/opt/nvt/current/bin/nvt-guest-sessiond --config /etc/nvt-agent/session.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
ReadOnlyPaths=/opt/nvt /etc/nvt-agent /run/nvt-agent-identity /run/nvt-agent
ReadWritePaths=/run/nvt-agent-session

[Install]
WantedBy=multi-user.target
