{
  "version": 1,
  "python_path": "/usr/bin/python3",
  "tmux_path": "/usr/bin/tmux",
  "state_dir": "/var/lib/nvt-agent",
  "socket_path": "/run/nvt-agent/agentd.sock",
  "workspace": "/workspace",
  "session_name": "agent",
  "session_startup_grace_seconds": 5,
  "session_command": [
    "@release/bin/nvt-guest-session-fixture",
    "--output",
    "/var/lib/nvt-agent/session-input.log"
  ]
}
