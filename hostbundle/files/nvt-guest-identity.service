[Unit]
Description=NVT native guest runtime identity
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
UMask=0077
StateDirectory=nvt-agent-identity
StateDirectoryMode=0700
RuntimeDirectory=nvt-agent-identity
RuntimeDirectoryMode=0700
ExecStart=/opt/nvt/current/bin/nvt-guest-identityd --config /etc/nvt-agent/identity.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=0
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
ReadOnlyPaths=/opt/nvt /etc/nvt-agent
ReadWritePaths=/run/nvt-agent-identity /var/lib/nvt-agent-identity

[Install]
WantedBy=multi-user.target
