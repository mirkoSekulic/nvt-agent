[Unit]
Description=NVT native guest mediated-egress session
After=network-online.target nvt-guest-identity.service
Wants=network-online.target
Requires=nvt-guest-identity.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=nvt-agent-egress
RuntimeDirectoryMode=0700
ExecStart=/opt/nvt/current/bin/nvt-guest-egressd --config /etc/nvt-agent/native-egress.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
ReadOnlyPaths=/opt/nvt /etc/nvt-agent /run/nvt-agent-identity
ReadWritePaths=/run/nvt-agent-egress

# This unit is deliberately not enabled by the bundle. A trusted provider may
# enable it only after supplying the explicit non-secret configuration and
# infrastructure confinement required by protocol/native-egress.md.
[Install]
WantedBy=multi-user.target
