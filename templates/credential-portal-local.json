{
  "auth": {
    "mode": "local",
    "session": {"cookieName": "nvt_local_credentials", "maxAgeSeconds": 3600, "secure": false},
    "local": {"principal": {"issuer": "local://workstation", "subject": "developer", "displayName": "Local developer"}}
  },
  "publicURL": "http://localhost:4090/agents/credentials",
  "returnURL": "/agents",
  "listenAddr": "0.0.0.0:8080",
  "namespace": "local",
  "slots": [
    {"name": "codex", "label": "Codex", "owner": {"issuer": "local://workstation", "subject": "developer"}, "adapter": "codex-oauth-file", "brokerProvider": "codex-main", "secretName": "local-seed", "dataKey": "auth.json"},
    {"name": "claude", "label": "Claude", "owner": {"issuer": "local://workstation", "subject": "developer"}, "adapter": "claude-oauth-file", "brokerProvider": "claude-main", "secretName": "local-seed", "dataKey": "credentials.json"}
  ],
  "enrollment": {"maxSessions": 16, "maxConcurrent": 2, "timeoutSeconds": 600, "maxOutputBytes": 65536, "experimentalCodexDeviceAuth": true},
  "maxUploadBytes": 65536,
  "recoveryUpload": {"enabled": true},
  "persistence": {"mode": "local", "local": {"directory": "/seed"}}
}
